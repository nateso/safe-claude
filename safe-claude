#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# safe-claude <path_to_folder> [claude-args...]   Enter/create a sandbox
# safe-claude update [-y] [--force]               Update tool + image to latest
# safe-claude rebuild <path_to_folder> [-y]        Rebuild one sandbox on new image
# safe-claude --version                            Show installed version
#
# Enter (or create) a Docker container that mounts the given folder as
# /workspace and has Claude Code pre-installed.
# ---------------------------------------------------------------------------

IMAGE_NAME="safe-claude"
REPO_URL="${SAFE_CLAUDE_REPO:-https://github.com/nateso/safe-claude.git}"
VERSION_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/safe-claude/version"

# ── helpers ────────────────────────────────────────────────────────────────

usage() {
  echo "Usage:"
  echo "  safe-claude <path_to_folder> [claude-args...]   Enter/create a sandbox for a folder"
  echo "  safe-claude update [-y] [--force]               Update the tool + image to latest main"
  echo "  safe-claude rebuild <path_to_folder> [-y]       Move an existing sandbox onto the new image"
  echo "  safe-claude --version                           Print the installed version"
  echo ""
  echo "  Entering a folder creates its container if it does not exist yet and"
  echo "  launches Claude Code. Any extra arguments are forwarded to 'claude', e.g.:"
  echo ""
  echo "    safe-claude ~/project --dangerously-skip-permissions"
  echo ""
  echo "  'update --force' also rebuilds the image with the Docker layer cache"
  echo "  disabled, forcing a fresh Claude Code install into it."
  echo ""
  echo "  Run install.sh first to build the '${IMAGE_NAME}' Docker image."
}

err() {
  echo "Error: $*" >&2
  exit 1
}

info()    { echo "[safe-claude] $*"; }
success() { echo "[safe-claude] OK $*"; }
warn()    { echo "[safe-claude] ! $*"; }

# Ask a yes/no question; returns 0 for yes. Default is No.
confirm() {
  local reply
  read -rp "$1 [y/N] " reply
  reply="${reply:-N}"
  [[ "$reply" =~ ^[Yy]$ ]]
}

# Resolve a path to an absolute path (works even with symlinks).
resolve_abs() {
  local p="$1"
  if command -v realpath &>/dev/null; then
    realpath "$p" 2>/dev/null || err "Path does not exist: $p"
  else
    (cd "$p" 2>/dev/null && pwd) || err "Path does not exist: $p"
  fi
}

# Derive a stable container name from an absolute path.
# Format: safe-claude-<basename>-<first-8-chars-of-md5>
container_name_for_path() {
  local abspath="$1"
  local base
  base=$(basename "$abspath" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g')
  local hash
  # md5sum on Linux, md5 on macOS
  if command -v md5sum &>/dev/null; then
    hash=$(printf '%s' "$abspath" | md5sum | cut -c1-8)
  else
    hash=$(printf '%s' "$abspath" | md5 | cut -c1-8)
  fi
  echo "safe-claude-${base}-${hash}"
}

# ── docker pre-flight ───────────────────────────────────────────────────────

require_docker() {
  command -v docker &>/dev/null || err "Docker is not installed or not on PATH."
  docker info &>/dev/null || err "Docker daemon is not running. Please start Docker and try again."
}

require_image() {
  docker image inspect "$IMAGE_NAME" &>/dev/null \
    || err "'${IMAGE_NAME}' Docker image not found. Run install.sh (or 'safe-claude update') to build it first."
}

# ── version tracking ────────────────────────────────────────────────────────

read_version() {
  [[ -f "$VERSION_FILE" ]] && head -n1 "$VERSION_FILE"
}

write_version() {
  mkdir -p "$(dirname "$VERSION_FILE")"
  printf '%s\n' "$1" > "$VERSION_FILE"
}

print_version() {
  local sha
  sha="$(read_version || true)"
  echo "safe-claude ${sha:-unknown}"
}

# ── update ──────────────────────────────────────────────────────────────────

cmd_update() {
  local assume_yes=0 force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes) assume_yes=1; shift ;;
      --force)  force=1;      shift ;;
      *) err "Unknown option for 'update': $1 (usage: safe-claude update [-y] [--force])" ;;
    esac
  done

  # Locate the on-PATH script file we should replace.
  local self="$0"
  [[ "$self" == */* ]] || self="$(command -v "$self")"
  self="$(resolve_abs "$self")"

  echo "safe-claude update"
  echo "  Updates the 'safe-claude' command and rebuilds the '${IMAGE_NAME}' image"
  echo "  from the latest 'main' (${REPO_URL})."
  echo "  Existing sandboxes are left untouched."
  echo "  Command file: ${self}"
  echo ""
  if [[ "$assume_yes" -ne 1 ]]; then
    confirm "Proceed?" || { echo "Update cancelled."; return 0; }
  fi

  command -v git &>/dev/null || err "git is required for 'update' but was not found on PATH."
  require_docker

  local tmp
  tmp="$(mktemp -d)"
  trap "rm -rf '$tmp'" EXIT   # expand $tmp now: it is 'local' and gone by EXIT-trap time

  info "Fetching latest from ${REPO_URL} (branch main)..."
  git clone --depth 1 --branch main "$REPO_URL" "$tmp" >/dev/null 2>&1 \
    || err "Failed to clone ${REPO_URL}. Check your network and git installation."

  local new_sha stored_sha
  new_sha="$(git -C "$tmp" rev-parse HEAD)"
  stored_sha="$(read_version || true)"
  if [[ "$force" -ne 1 && -n "$stored_sha" && "$stored_sha" == "$new_sha" ]]; then
    success "Already up to date (${new_sha:0:8})."
    return 0
  fi

  # Replace the installed command atomically (rename => new inode, so this
  # running process keeps its old inode and is not corrupted mid-run).
  info "Updating command at ${self}..."
  local tmpdest="${self}.tmp.$$"
  if [[ -w "$(dirname "$self")" ]]; then
    install -m 755 "$tmp/safe-claude" "$tmpdest" && mv -f "$tmpdest" "$self"
  else
    info "  '$(dirname "$self")' requires elevated permissions — using sudo."
    sudo install -m 755 "$tmp/safe-claude" "$tmpdest" && sudo mv -f "$tmpdest" "$self"
  fi
  success "Command updated."

  # --pull refreshes the base image. Docker keys its layer cache on instruction
  # text, and this Dockerfile has no COPY, so an unchanged Dockerfile would
  # otherwise rebuild to a byte-identical image -- including a stale Claude Code
  # install layer. '--force' therefore also means "do not trust the cache".
  local build_args=(--pull)
  if [[ "$force" -eq 1 ]]; then
    build_args+=(--no-cache)
    info "Rebuilding Docker image '${IMAGE_NAME}' from scratch (--force: cache disabled)..."
  else
    info "Rebuilding Docker image '${IMAGE_NAME}' (this may take a few minutes)..."
  fi
  docker build "${build_args[@]}" -t "$IMAGE_NAME" "$tmp" || err "Docker build failed. See output above."
  success "Image '${IMAGE_NAME}' rebuilt."

  write_version "$new_sha"
  success "Updated to ${new_sha:0:8}."

  # Report existing sandboxes; do NOT recreate them.
  local sandboxes
  sandboxes="$(docker ps -a --filter name=safe-claude- --format '  {{.Names}} ({{.Status}})' || true)"
  if [[ -n "$sandboxes" ]]; then
    echo ""
    warn "Existing sandboxes still run the previous image:"
    echo "$sandboxes"
    echo ""
    echo "  They keep working as-is. To move one onto the new image"
    echo "  (Claude login/history preserved), run:"
    echo "      safe-claude rebuild <path>"
  fi
}

# ── rebuild (opt-in per-sandbox migration onto the new image) ────────────────

cmd_rebuild() {
  local assume_yes=0 patharg=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes) assume_yes=1; shift ;;
      -*) err "Unknown option for 'rebuild': $1" ;;
      *)  [[ -z "$patharg" ]] \
            || err "'rebuild' takes a single folder; unexpected extra argument: $1"
          patharg="$1"; shift ;;
    esac
  done
  [[ -n "$patharg" ]] || err "Usage: safe-claude rebuild <path_to_folder> [-y]"

  require_docker
  require_image

  local abs
  abs="$(resolve_abs "$patharg")"
  [[ -d "$abs" ]] || err "Not a directory: $patharg"

  local container volume
  container="$(container_name_for_path "$abs")"
  volume="${container}-claude"

  docker container inspect "$container" &>/dev/null \
    || err "No sandbox exists for ${abs} (container '${container}'). Nothing to rebuild."

  echo "safe-claude rebuild"
  echo "  Sandbox: ${container}"
  echo "  Folder:  ${abs}  (your files here are NOT touched)"
  echo ""
  echo "  This recreates the sandbox on the current '${IMAGE_NAME}' image."
  echo "  Claude login/history is preserved via a Docker volume."
  echo "  System packages installed inside the container (apt/pip) are NOT carried over"
  echo "  (a backup image of the old container is made so you can recover them)."
  echo ""
  if [[ "$assume_yes" -ne 1 ]]; then
    confirm "Rebuild this sandbox?" || { echo "Rebuild cancelled."; return 0; }
  fi

  local tmp
  tmp="$(mktemp -d)"
  trap "rm -rf '$tmp'" EXIT   # expand $tmp now: it is 'local' and gone by EXIT-trap time

  # Is /home/node/.claude already backed by a named volume?
  local uses_volume
  uses_volume="$(docker inspect --format \
    '{{range .Mounts}}{{if eq .Destination "/home/node/.claude"}}{{.Name}}{{end}}{{end}}' \
    "$container")"

  if [[ -z "$uses_volume" ]]; then
    info "Migrating Claude login/history into volume '${volume}'..."
    mkdir -p "$tmp/claude"
    docker cp "$container:/home/node/.claude/." "$tmp/claude/" \
      || err "Failed to copy /home/node/.claude out of the container."
    docker volume create "$volume" >/dev/null
    # Seed the volume via a helper container that has it mounted. We only ever
    # bind-mount a *named volume* (never a host path), so this works identically
    # on Linux, macOS, and Docker Desktop for Windows.
    local helper="${container}-seed"
    docker rm -f "$helper" &>/dev/null || true
    docker run -d --name "$helper" -v "$volume:/dest" "$IMAGE_NAME" tail -f /dev/null >/dev/null
    docker cp "$tmp/claude/." "$helper:/dest/" \
      || { docker rm -f "$helper" &>/dev/null; err "Failed to seed volume '${volume}'."; }
    # 1000:1000 is the image's built-in 'node' user, which is who Claude runs as
    # on macOS/Windows. On Linux, entering the sandbox re-chowns /home/node to
    # your host UID/GID (see the RUN_USER block below), so this is just a sane
    # starting point rather than the final ownership.
    docker exec -u 0 "$helper" sh -c 'chown -R 1000:1000 /dest' || true
    docker rm -f "$helper" >/dev/null
    success "Volume '${volume}' seeded from the old container."
  else
    info "Sandbox already uses volume '${uses_volume}'; login/history will persist automatically."
    volume="$uses_volume"
  fi

  # Safety backup of the whole old container (captures apt/pip installs too).
  local ts base backup
  ts="$(date +%Y%m%d-%H%M%S)"
  base="$(basename "$abs" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g')"
  backup="safe-claude-backup-${base}-${ts}"
  info "Creating safety backup image '${backup}'..."
  docker commit "$container" "$backup" >/dev/null \
    || warn "Could not create backup image (continuing anyway)."

  info "Removing old container and recreating on the new image..."
  docker rm -f "$container" >/dev/null
  docker run -dit \
    --name "$container" \
    -v "${abs}:/workspace" \
    -v "${volume}:/home/node/.claude" \
    "$IMAGE_NAME" >/dev/null \
    || err "Failed to recreate container. Your files are safe in ${abs}; backup image: ${backup}."

  success "Sandbox rebuilt on the '${IMAGE_NAME}' image."
  echo "  Backup of the previous container: image '${backup}'"
  echo "  Inspect it with:       docker run --rm -it ${backup} bash"
  echo "  Remove it when done:   docker rmi ${backup}"
  echo ""
  echo "  Enter the refreshed sandbox with:  safe-claude ${patharg}"
}

# ── command dispatch ─────────────────────────────────────────────────────────

case "${1:-}" in
  update)         shift; cmd_update  "$@"; exit $? ;;
  rebuild)        shift; cmd_rebuild "$@"; exit $? ;;
  --version|-v)   print_version; exit 0 ;;
  help|--help|-h) usage; exit 0 ;;
esac

# ── argument validation ─────────────────────────────────────────────────────

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 1
fi

FOLDER_PATH="$1"
shift   # any remaining args ("$@") are forwarded verbatim to `claude`

# Resolve to absolute path (works even if the path contains symlinks)
ABS_PATH="$(resolve_abs "$FOLDER_PATH")"

[[ -d "$ABS_PATH" ]] || err "Not a directory: $FOLDER_PATH"

CONTAINER="$(container_name_for_path "$ABS_PATH")"

# ── pre-flight checks ───────────────────────────────────────────────────────

require_docker
require_image

# ── container lifecycle ─────────────────────────────────────────────────────

if ! docker container inspect "$CONTAINER" &>/dev/null; then
  # Container does not exist yet — create it.
  # A per-sandbox named volume backs /home/node/.claude so Claude's login and
  # session history survive container recreation (e.g. 'safe-claude rebuild').
  echo "No container found for this folder. Creating '${CONTAINER}'..."
  docker run -dit \
    --name "$CONTAINER" \
    -v "${ABS_PATH}:/workspace" \
    -v "${CONTAINER}-claude:/home/node/.claude" \
    "$IMAGE_NAME" \
    > /dev/null
  echo "Container created."
else
  # Container exists — start it if it is not already running
  STATUS=$(docker container inspect --format '{{.State.Status}}' "$CONTAINER")
  if [[ "$STATUS" != "running" ]]; then
    echo "Starting container '${CONTAINER}'..."
    docker start "$CONTAINER" > /dev/null
  fi
fi

# ── enter the container ─────────────────────────────────────────────────────

echo "Entering container '${CONTAINER}' (folder: ${ABS_PATH})..."

# Non-blocking heads-up if skip-permissions was requested.
case " $* " in
  *" --dangerously-skip-permissions "*)
    echo "WARNING: Claude will read/modify/delete and run commands in" >&2
    echo "         ${ABS_PATH} WITHOUT asking. Make sure you trust and have backed up this folder." >&2
    ;;
esac

# Decide which user Claude runs as inside the container.
#
# Claude Code refuses --dangerously-skip-permissions as root, so it must run as a
# non-root user. On native Linux, Docker maps bind-mount ownership by numeric UID,
# so we run Claude as *your* host UID/GID -- that way files it writes in the mounted
# folder are owned by you, not by an unrelated container user. On macOS/Windows,
# Docker Desktop maps ownership for us, so the built-in 'node' user is enough.
RUN_USER="node"
if [[ "$(uname -s)" == "Linux" ]]; then
  HOST_UID="$(id -u)"
  HOST_GID="$(id -g)"
  if [[ "$HOST_UID" -ne 0 ]]; then
    # Ensure the container has a passwd/group entry for your UID/GID (so tools that
    # look up the user by ID don't fail) and that HOME is writable by it. Idempotent.
    docker exec -u 0 "$CONTAINER" sh -c '
      getent group  "$2" >/dev/null || echo "hostgrp:x:$2:"                                     >> /etc/group
      getent passwd "$1" >/dev/null || echo "hostuser:x:$1:$2:host user:/home/node:/bin/bash"   >> /etc/passwd
      chown -R "$1:$2" /home/node
    ' _ "$HOST_UID" "$HOST_GID"
    RUN_USER="${HOST_UID}:${HOST_GID}"
  fi
fi

echo "Type 'exit' or press Ctrl+D to leave the container."
echo ""
docker exec -it -u "$RUN_USER" -e HOME=/home/node "$CONTAINER" claude "$@"
