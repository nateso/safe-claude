#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# safe-claude <path_to_folder> [claude-args...]   Enter/create a sandbox
# safe-claude update                              Update tool + image to latest
# safe-claude list                                Show every sandbox and its state
# safe-claude migrate <path_to_folder>            migrates the sandbox to the new image
# safe-claude remove <path>                       Remove a sandbox
# safe-claude --version                           Show installed version
#
# Enter (or create) a Docker container that mounts the given folder as
# /workspace and has Claude Code pre-installed.
# ---------------------------------------------------------------------------

IMAGE_NAME="ghcr.io/nateso/safe-claude:latest"
INSTALL_SCRIPT_URL="https://raw.githubusercontent.com/nateso/safe-claude/main/install.sh"

# ── helpers ────────────────────────────────────────────────────────────────

usage() {
  echo "Usage:"
  echo "  safe-claude <path_to_folder> [claude-args...]   Enter/create a sandbox for a folder"
  echo "  safe-claude update                              Update the tool + image to latest main"
  echo "  safe-claude list                                Show every sandbox and its state"
  echo "  safe-claude migrate <path_to_folder>            Move an existing sandbox onto the new image"
  echo "  safe-claude remove <path_to_folder>             Remove a sandbox (keeps your files)"
  echo "  safe-claude --version                           Print the installed version"
  echo ""
  echo "  Entering a folder creates its container if it does not exist yet and"
  echo "  launches Claude Code. Any extra arguments are forwarded to 'claude', e.g.:"
  echo ""
  echo "    safe-claude ~/project --dangerously-skip-permissions"
  echo ""
  echo ""
  echo "  First install the safe-claude command via: "
  echo '      bash -c "$(curl -fsSL https://raw.githubusercontent.com/nateso/safe-claude/main/install.sh)"'
}

err() {
  echo "Error: $*" >&2
  exit 1
}

info()    { echo "[safe-claude] $*"; }
success() { echo "[safe-claude] OK $*"; }
warn()    { echo "[safe-claude] ! $*"; }

# Ask a yes/no question; returns 0 for yes. Default is No.
confirm() {
  local reply
  read -rp "$1 [y/N] " reply
  reply="${reply:-N}"
  [[ "$reply" =~ ^[Yy]$ ]]
}

# Resolve a path to an absolute path (works even with symlinks).
resolve_abs() {
  local p="$1"
  if command -v realpath &>/dev/null; then
    realpath "$p" 2>/dev/null || err "Path does not exist: $p"
  else
    (cd "$p" 2>/dev/null && pwd) || err "Path does not exist: $p"
  fi
}

# Derive a stable container name from an absolute path.
# Format: safe-claude-<basename>-<first-8-chars-of-md5>
container_name_for_path() {
  local abspath="$1"
  local base
  base=$(basename "$abspath" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g')
  local hash
  # md5sum on Linux, md5 on macOS
  if command -v md5sum &>/dev/null; then
    hash=$(printf '%s' "$abspath" | md5sum | cut -c1-8)
  else
    hash=$(printf '%s' "$abspath" | md5 | cut -c1-8)
  fi
  echo "safe-claude-${base}-${hash}"
}

# ── docker pre-flight ───────────────────────────────────────────────────────

require_docker() {
  command -v docker &>/dev/null || err "Docker is not installed or not on PATH."
  docker info &>/dev/null || err "Docker daemon is not running. Please start Docker and try again."
}

require_image() {
  docker image inspect "$IMAGE_NAME" &>/dev/null \
    || err "'${IMAGE_NAME}' Docker image not found. Run install.sh (or 'safe-claude update') to pull it first."
}

# Image version tag stamped into the current image by the Dockerfile's LABEL.
# Prints 'unknown' for images built without the build-arg.
image_version() {
  local v
  v="$(docker image inspect "$IMAGE_NAME" \
        --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' 2>/dev/null)" || v=""
  if [[ -z "$v" || "$v" == "<no value>" ]]; then
    printf 'unknown'
  else
    printf '%s' "$v"
  fi
}

# Docker renders an unset label as '<no value>'. Echo $1, or $2 when $1 is unset.
label_or() {
  if [[ -z "$1" || "$1" == "<no value>" ]]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}

# Names of all sandbox containers, newest Docker name-filter regex so we do not
# match a user's unrelated container that merely contains the string, and
# skipping the transient '-seed' helper a crashed rebuild can leave behind.
sandbox_names() {
  docker ps -a --filter 'name=^safe-claude-' --format '{{.Names}}' || true
}

# ── version tracking ────────────────────────────────────────────────────────
print_version() {
  require_docker
  echo "safe-claude $(image_version)"
}

# ── update ──────────────────────────────────────────────────────────────────

cmd_update() {
  echo "safe-claude update"
  echo "  Pulls the latest image and updates the 'safe-claude' command."
  echo "  Existing sandboxes are left untouched."
  echo ""

  local old_id=""
  old_id=$(docker image inspect "$IMAGE_NAME" --format '{{.Id}}' 2>/dev/null || true)

  # just call the installation script from the web (the domain should be stable!)
  bash -c "$(curl -fsSL "$INSTALL_SCRIPT_URL")"

  # Report existing sandboxes; do NOT recreate them.
  local new_id=""
  new_id=$(docker image inspect "$IMAGE_NAME" --format '{{.Id}}' 2>/dev/null || true)

  if [[ -n "$old_id" && "$old_id" != "$new_id" ]]; then
    # Find sandboxes running the old image.
    local stale_paths=()
    local names
    names="$(sandbox_names)"
    [[ -n "$names" ]] || return 0

    local tmpl='{{.Image}}|{{index .Config.Labels "safe-claude.path"}}'
    while IFS='|' read -r img path; do
      [[ -n "$img" ]] || continue
      if [[ "$img" != "$new_id" && -n "$path" && "$path" != "<no value>" ]]; then
        stale_paths+=("$path")
      fi
    done < <(docker inspect --format "$tmpl" $names 2>/dev/null || true)

    if [[ ${#stale_paths[@]} -gt 0 ]]; then
      echo ""
      warn "${#stale_paths[@]} sandbox(es) still run the previous image."
      if confirm "Migrate all of them to the new image now?"; then
        for path in "${stale_paths[@]}"; do
          echo ""
          cmd_migrate "$path"
        done
      else
        echo "  You can migrate them individually later with:"
        echo "      safe-claude migrate <path_to_folder>"
      fi
    fi
  fi
}

# ── list ─────────────────────────────────────────────────────────────────────

cmd_list() {
  [[ $# -eq 0 ]] || err "'list' takes no arguments (got: $1)"

  require_docker

  local names
  names="$(sandbox_names)"
  if [[ -z "$names" ]]; then
    info "No sandboxes yet. Create one with:  safe-claude <path_to_folder>"
    return 0
  fi

  local current_id current_ver=""
  current_id="$(docker image inspect "$IMAGE_NAME" --format '{{.Id}}' 2>/dev/null || true)"
  if [[ -z "$current_id" ]]; then
    warn "The '${IMAGE_NAME}' image is not pulled, so sandboxes cannot be compared against it."
  else
    current_ver="$(image_version)"
    if [[ "$current_ver" == "unknown" ]]; then current_ver=""; fi
  fi

  # One inspect call for every sandbox, rather than one per sandbox.
  local tmpl='{{.Name}}|{{.State.Status}}|{{.Image}}|{{index .Config.Labels "safe-claude.path"}}|{{index .Config.Labels "safe-claude.version"}}|{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}'
  local raw
  # shellcheck disable=SC2086  # deliberate word-splitting: $names is a list
  raw="$(docker inspect --format "$tmpl" $names 2>/dev/null || true)"
  [[ -n "$raw" ]] || err "Could not inspect the sandbox containers."

  local rows=() suggest=() width=6 total=0 stale=0
  local name status img lpath lver msrc path folder ver image_col note

  while IFS='|' read -r name status img lpath lver msrc; do
    [[ -n "$name" ]] || continue
    total=$((total + 1))

    path="$(label_or "$lpath" "$msrc")"
    [[ -n "$path" ]] || path="(unknown)"
    folder="$(basename "$path")"

    if [[ -z "$current_id" ]]; then
      image_col="unknown"          # nothing to compare against
    elif [[ "$img" == "$current_id" ]]; then
      image_col="current"
    else
      image_col="outdated"
      stale=$((stale + 1))
    fi
    ver="$(label_or "$lver" "")"
    if [[ "$ver" == "unknown" ]]; then ver=""; fi
    # A sandbox running the current image is, by definition, that image's
    # version -- so fill it in for containers created before version stamping.
    if [[ -z "$ver" && -n "$current_id" && "$img" == "$current_id" ]]; then
      ver="$current_ver"
    fi
    if [[ -n "$ver" ]]; then
      image_col="${image_col} (${ver})"
    fi

    note=""
    if [[ "$path" != "(unknown)" && ! -d "$path" ]]; then
      note="  (folder missing)"
    fi

    # Only suggest a migrate if the sandbox is outdated and we have what we need.
    local needs_migrate=0
    if [[ "$image_col" == outdated* ]]; then needs_migrate=1; fi
    if [[ -z "$current_id" || "$path" == "(unknown)" ]]; then needs_migrate=0; fi
    if [[ "$needs_migrate" -eq 1 ]]; then suggest+=("$path"); fi

    [[ ${#folder} -le $width ]] || width=${#folder}
    rows+=("${folder}|${status}|${image_col}|${path}${note}")
  done <<< "$raw"

  [[ ${#rows[@]} -gt 0 ]] || err "Could not read any sandbox details."

  echo ""
  printf '%-*s  %-8s  %-20s  %s\n' "$width" "FOLDER" "STATUS" "IMAGE" "PATH"
  while IFS='|' read -r folder status image_col path; do
    printf '%-*s  %-8s  %-20s  %s\n' \
      "$width" "$folder" "$status" "$image_col" "$path"
  done < <(printf '%s\n' "${rows[@]}" | sort)

  echo ""
  printf '%d sandbox' "$total"
  [[ "$total" -eq 1 ]] || printf 'es'
  printf '.'
  [[ "$stale" -eq 0 ]] || printf '  %d on an older image.' "$stale"
  printf '\n'

  if [[ -n "$current_id" && -z "$current_ver" ]]; then
    echo ""
    echo "  The image carries no version stamp. Update with:"
    echo "      safe-claude update"
  fi

  if [[ ${#suggest[@]} -gt 0 ]]; then
    echo ""
    echo "  Move a sandbox onto the current image:"
    while IFS= read -r path; do
      echo "      safe-claude migrate ${path}"
    done < <(printf '%s\n' "${suggest[@]}" | sort -u)
  fi
}

# ── command migrate (opt-in for each container) ─────────────────────────────────────────────────────────
# during migration all credentials and claude settings persist.
# allows users to keep their claude environments in tact
cmd_migrate() {
  local patharg=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -*) err "Unknown option for 'migrate': $1" ;;
      *)  [[ -z "$patharg" ]] \
            || err "'migrate' takes a single folder; unexpected extra argument: $1"
          patharg="$1"; shift ;;
    esac
  done
  [[ -n "$patharg" ]] || err "Usage: safe-claude migrate <path_to_folder>"

  require_docker
  require_image

  local abs
  abs="$(resolve_abs "$patharg")"
  [[ -d "$abs" ]] || err "Not a directory: $patharg"

  local container
  container="$(container_name_for_path "$abs")"

  docker container inspect "$container" &>/dev/null \
    || err "No sandbox exists for ${abs}. Nothing to migrate."

  # Copy .claude from the container to the host if not already there.
  if [[ ! -d "${abs}/.safe-claude" ]]; then
    info "Copying Claude config from container to ${abs}/.safe-claude ..."
    mkdir -p "${abs}/.safe-claude"
    docker cp "$container:/home/node/.claude/." "${abs}/.safe-claude/" \
      || warn "Could not copy .claude from the container (it may be empty)."
    success "Config copied."
  else
    info ".safe-claude already exists — nothing to copy."
  fi

  info "Removing old container..."
  docker rm -f "$container" >/dev/null

  info "Recreating container on the current image..."
  docker run -dit \
    --name "$container" \
    --label "safe-claude.path=${abs}" \
    --label "safe-claude.version=$(image_version)" \
    -v "${abs}:/workspace" \
    -v "${abs}/.safe-claude:/home/node/.claude" \
    "$IMAGE_NAME" \
    > /dev/null

  success "Sandbox migrated. Enter it with:  safe-claude ${patharg}"
}

# ── command remove (opt-in for each container) ─────────────────────────────────────────────────────────
cmd_remove() {
  local patharg=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -*) err "Unknown option for 'remove': $1" ;;
      *)  [[ -z "$patharg" ]] \
            || err "'remove' takes a single folder; unexpected extra argument: $1"
          patharg="$1"; shift ;;
    esac
  done
  [[ -n "$patharg" ]] || err "Usage: safe-claude remove <path_to_folder>"

  require_docker

  local abs
  abs="$(resolve_abs "$patharg")"

  local container
  container="$(container_name_for_path "$abs")"

  docker container inspect "$container" &>/dev/null \
    || err "No sandbox exists for ${abs}. Nothing to remove."

  info "Removing container '${container}'..."
  docker rm -f "$container" >/dev/null
  success "Sandbox removed."
  echo "  Your project files in ${abs} are untouched."

  if [[ -d "${abs}/.safe-claude" ]]; then
    if confirm "Also delete ${abs}/.safe-claude (credentials, history, settings)?"; then
      rm -rf "${abs}/.safe-claude"
      success "Claude config removed."
    else
      info "Kept ${abs}/.safe-claude"
    fi
  fi
}


# ── command dispatch ─────────────────────────────────────────────────────────

case "${1:-}" in
  update)         shift; cmd_update  "$@"; exit $? ;;
  list)           shift; cmd_list    "$@"; exit $? ;;
  migrate)        shift; cmd_migrate "$@"; exit $? ;;
  remove|rm)      shift; cmd_remove  "$@"; exit $? ;;
  --version|-v)   print_version; exit 0 ;;
  help|--help|-h) usage; exit 0 ;;
esac

# ── argument validation ─────────────────────────────────────────────────────

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 1
fi

FOLDER_PATH="$1"
shift   # any remaining args ("$@") are forwarded verbatim to `claude`

# Resolve to absolute path (works even if the path contains symlinks)
ABS_PATH="$(resolve_abs "$FOLDER_PATH")"

[[ -d "$ABS_PATH" ]] || err "Not a directory: $FOLDER_PATH"

CONTAINER="$(container_name_for_path "$ABS_PATH")"

# ── pre-flight checks ───────────────────────────────────────────────────────

require_docker
require_image

# ── container lifecycle ─────────────────────────────────────────────────────
if ! docker container inspect "$CONTAINER" &>/dev/null; then
  # Container does not exist yet — create it.
  # claude settings are stored in <path_to_folder>/.safe-claude so Claude's login and
  # session history survive container recreation (e.g. 'safe-claude migrate').
  echo "No container found for this folder. Creating '${CONTAINER}'..."
  # if it does not exist yet, create a .safe-claude directory inside the volume
  # claude will save all of its credentials etc there '
  mkdir -p "${ABS_PATH}/.safe-claude"
  # run the docker container
  docker run -dit \
    --name "$CONTAINER" \
    --label "safe-claude.path=${ABS_PATH}" \
    --label "safe-claude.version=$(image_version)" \
    -v "${ABS_PATH}:/workspace" \
    -v "${ABS_PATH}/.safe-claude:/home/node/.claude" \
    "$IMAGE_NAME" \
    > /dev/null
  echo "Container created."
else
  # Container exists — start it if it is not already running
  STATUS=$(docker container inspect --format '{{.State.Status}}' "$CONTAINER")
  if [[ "$STATUS" != "running" ]]; then
    echo "Starting container '${CONTAINER}'..."
    docker start "$CONTAINER" > /dev/null
  fi
fi

# ── enter the container ─────────────────────────────────────────────────────

echo "Entering container '${CONTAINER}' (folder: ${ABS_PATH})..."

# Non-blocking heads-up if skip-permissions was requested.
case " $* " in
  *" --dangerously-skip-permissions "*)
    echo "WARNING: Claude will read/modify/delete and run commands in" >&2
    echo "         ${ABS_PATH} WITHOUT asking. Make sure you trust and have backed up this folder." >&2
    ;;
esac

# Decide which user Claude runs as inside the container.
#
# Claude Code refuses --dangerously-skip-permissions as root, so it must run as a
# non-root user. On native Linux, Docker maps bind-mount ownership by numeric UID,
# so we run Claude as *your* host UID/GID -- that way files it writes in the mounted
# folder are owned by you, not by an unrelated container user. On macOS/Windows,
# Docker Desktop maps ownership for us, so the built-in 'node' user is enough.
RUN_USER="node"
if [[ "$(uname -s)" == "Linux" ]]; then
  HOST_UID="$(id -u)"
  HOST_GID="$(id -g)"
  if [[ "$HOST_UID" -ne 0 ]]; then
    # Ensure the container has a passwd/group entry for your UID/GID (so tools that
    # look up the user by ID don't fail) and that HOME is writable by it. Idempotent.
    docker exec -u 0 "$CONTAINER" sh -c '
      getent group  "$2" >/dev/null || echo "hostgrp:x:$2:"                                     >> /etc/group
      getent passwd "$1" >/dev/null || echo "hostuser:x:$1:$2:host user:/home/node:/bin/bash"   >> /etc/passwd
      chown -R "$1:$2" /home/node
    ' _ "$HOST_UID" "$HOST_GID"
    RUN_USER="${HOST_UID}:${HOST_GID}"
  fi
fi

echo "Type 'exit' or press Ctrl+D to leave the container."
echo ""
docker exec -it -u "$RUN_USER" -e HOME=/home/node "$CONTAINER" claude "$@"
